/**
 * Configuração do Worker do conector MCP da Cloudbeds — Hotel Britânico.
 * Referência: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Segredos (nunca neste arquivo; definir com `npx wrangler secret put <NOME>`):
 *   CLOUDBEDS_API_KEY      chave da Cloudbeds só para este conector (prefixo cbat_)
 *   GITHUB_CLIENT_ID       OAuth App do GitHub usada no login
 *   GITHUB_CLIENT_SECRET
 *   COOKIE_ENCRYPTION_KEY  `openssl rand -hex 32`
 *
 * Em desenvolvimento local os mesmos nomes vão em `.dev.vars` (fora do git).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudbeds-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // URL exata que os clientes MCP usam. Todo token OAuth fica amarrado a ela.
    // Descoberta no primeiro deploy, em 24/11/2026.
    "MCP_RESOURCE": "https://cloudbeds-mcp.reservas-1f7.workers.dev/mcp",
    // Logins do GitHub autorizados, separados por vírgula. Vazio = ninguém entra.
    "ALLOWED_GITHUB_LOGINS": "britanicohotel",
    "CLOUDBEDS_PROPERTY_ID": "7830",
    "HOTEL_TIMEZONE": "America/Sao_Paulo",
    // Teto de dias por período nas análises. Protege o limite de 50 subrequisições
    // e de 10 ms de CPU por requisição do plano gratuito.
    "MAX_PERIOD_DAYS": "62"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Criado em 24/11/2026 com `npx wrangler kv namespace create OAUTH_KV`
      "id": "a7b50a977b3b4aecb538d6483b0e59ce"
    }
  ],
  "d1_databases": [
    {
      // Espelho das reservas (Fase 3). Sem dados pessoais de hóspede.
      "binding": "DB",
      "database_name": "cloudbeds_mcp",
      // Criado em 24/11/2026 com `npx wrangler d1 create cloudbeds_mcp`
      "database_id": "b287bf5e-3206-4ab0-8694-f7073143729e"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  },
  "secrets": {
    // Esta lista controla três coisas ao mesmo tempo: barra o deploy sem estes
    // segredos, define quais nomes o `wrangler dev` lê do .dev.vars e quais o
    // `npm run cf-typegen` tipa no Env. Só entram segredos sem os quais o
    // Worker não deve ir para o ar. CLOUDBEDS_API_KEY (e, na Fase 4,
    // CLOUDBEDS_WEBHOOK_SECRET) podem faltar e ficam FORA: tipados à mão como
    // opcionais em src/env.d.ts. Ver ESTADO.md.
    "required": [
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "COOKIE_ENCRYPTION_KEY"
    ]
  }
}
